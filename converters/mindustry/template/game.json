  "globals": {
    "planet": {
      "label": "Planet filter",
      "tooltip": "Filter which planet's blocks and recipes appear in the picker (Serpulo, Erekir, or All for Mixtech).",
      "type": "enum",
      "option_set": "planets",
      "default": "all",
      "ui": {
        "widget": "combo",
        "group": "Scope"
      }
    },
    "show_debug": {
      "label": "Show debug/hidden content",
      "tooltip": "Show unfinished/hidden blocks and recipes (Slag Centrifuge, Heat Reactor, Fissile Matter RTG) in the picker.",
      "type": "bool",
      "default": false,
      "ui": {
        "widget": "checkbox",
        "group": "Scope"
      }
    },
    "power_mode": {
      "label": "Power modeling",
      "tooltip": "Track power as a summary metric only (cleaner graph), as an explicit solver resource with power ports on every machine (auto-sizes power plants), or both.",
      "type": "enum",
      "option_set": "power_modes",
      "default": "metric",
      "ui": {
        "widget": "combo",
        "group": "Scope"
      }
    },
    "solar_mult": {
      "label": "Solar multiplier",
      "tooltip": "Sector solar multiplier scaling Solar Panel power output (1.0x is standard daylight).",
      "notes": "Scales SolarGenerator productionEfficiency per SolarGenerator.java:29 (v160.8).",
      "type": "number",
      "default": 1,
      "min": "0",
      "max": "10",
      "step": 0.1,
      "ui": {
        "widget": "drag",
        "format": "%.2gx",
        "group": "Map rules"
      }
    },
    "unit_build_speed": {
      "label": "Unit build speed",
      "tooltip": "Map rule multiplier for Unit Factory, Reconstructor, and Unit Assembler build speed.",
      "notes": "Maps to state.rules.unitBuildSpeed (UnitFactory.java:411, Reconstructor.java:339, UnitAssembler.java:531, v160.8).",
      "type": "number",
      "default": 1,
      "min": "0.05",
      "max": "20",
      "step": 0.1,
      "ui": {
        "widget": "drag",
        "format": "%.2gx",
        "group": "Map rules"
      }
    },
    "unit_cost_mult": {
      "label": "Unit cost multiplier",
      "tooltip": "Map rule multiplier for item, liquid, and payload costs in unit production.",
      "notes": "Maps to state.rules.unitCost (UnitFactory.java:109, Reconstructor.java:155, UnitAssembler.java:179, v160.8).",
      "type": "number",
      "default": 1,
      "min": "0.05",
      "max": "10",
      "step": 0.1,
      "ui": {
        "widget": "drag",
        "format": "%.2gx",
        "group": "Map rules"
      }
    }
  },
