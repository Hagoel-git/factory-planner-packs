      "type": "enum",
      "option_set": "pump_floors",
      "allowed_if": "option.mult >= recipe.min_liquid_mult && option.mult <= recipe.max_liquid_mult",
      "visible_if": "recipe.min_liquid_mult != 1 || recipe.max_liquid_mult != 1",
      "ui": {
        "widget": "combo",
        "placement": "panel",
        "group": "Tile placement"
      }
