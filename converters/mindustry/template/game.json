        "tooltip",
        "totals"
      ],
      "aggregate": "sum",
      "split_sign": true,
      "is_rate": false,
      "notes": "Mindustry power balance in units/s (consumption positive, generation negative; PowerGraph.java:100,112, v160.8). Impact Reactor reports net -6300 u/s (7800 gen - 1500 draw)."
    },
    "footprint": {
      "label": "Footprint",
      "unit": "tiles²",
      "format": "%.0f",
      "display": [
        "tooltip",
        "totals"
      ],
      "aggregate": "sum",
      "split_sign": false,
      "is_rate": false,
      "notes": "Whole-building physical tile area: ceil(max(0, node.machines - 1e-6)) * machine.size^2."
    }
  },
  "profiles": {
    "mindustry_base": {
      "notes": "Shared Mindustry 160.8 base profile: planet/debug picker visibility, Overdrive timeScale (BuildingComp.java:delta, PowerGraph.java:100,112), fixed-rate liquid support (ConsumeLiquid.java:31), switchable power resource ports + power metric via global.power_mode, and footprint metric.",
      "visible_if": "(global.show_debug || !machine.is_debug) && (global.planet == 'all' || machine.planet == 'both' || machine.planet == global.planet)",
      "recipe_visible_if": "(global.show_debug || !recipe.is_debug) && (global.planet == 'all' || recipe.planet == 'both' || recipe.planet == global.planet)",
      "params": [
        "overdrive"
      ],
      "let": {
        "od": "if(machine.can_overdrive, param.overdrive.mult, 1)",
        "net_power": "machine.power * recipe.power_mult * od",
        "native_power_out": "false",
        "use_power_ports": "global.power_mode == 'resource' || global.power_mode == 'both'",
        "show_power_metric": "global.power_mode == 'metric' || global.power_mode == 'both'"
      },
      "craft_time": "recipe.time / (machine.speed * od)",
      "input_amount": "if(port.fixed_rate, port.amount * od * craft_time, port.amount * port.chance)",
      "output_amount": "port.amount * port.chance",
      "extra_ports": [
        {
          "id": "power_in",
          "dir": "in",
          "resource": "power",
          "amount": "max(0, net_power) * craft_time",
          "enabled": "use_power_ports && net_power > 0"
        },
        {
          "id": "power_out",
          "dir": "out",
          "resource": "power",
          "amount": "max(0, -net_power) * craft_time",
          "enabled": "use_power_ports && !native_power_out && net_power < 0"
        }
      ],
      "metrics": {
        "power": {
          "enabled": "show_power_metric",
          "per_machine": "net_power"
        },
        "footprint": {
          "value": "ceil(max(0, node.machines - 1e-6)) * machine.size ^ 2"
        }
      }
    },
    "mindustry_crafter": {
      "extends": "mindustry_base",
      "notes": "Standard crafters, separators, heat producers, constructor, vents, and steady-state fuel/coolant generators (GenericCrafter.java, Separator.java, HeatProducer.java, ConsumeGenerator.java, NuclearReactor.java, ImpactReactor.java, HeaterGenerator.java, BlockProducer.java, v160.8)."
    },
    "mindustry_attribute_crafter": {
      "extends": "mindustry_base",
      "notes": "AttributeCrafter (silicon-crucible, cultivator; AttributeCrafter.java:91-111, v160.8). Speed scales with tile_eff; silicon-crucible also scales item output yield (scales_yield=true); cultivator water input is fixed_rate=true.",
      "params": [
        "tile_preset",
        "tile_efficiency"
      ],
      "let": {
        "tile_eff": "if(param.tile_preset == 'custom', param.tile_efficiency, param.tile_preset.eff) / 100"
      },
      "craft_time": "recipe.time / (machine.speed * od * tile_eff)",
      "output_amount": "port.amount * port.chance * if(machine.scales_yield, tile_eff, 1)"
    },
    "mindustry_heat_crafter": {
      "extends": "mindustry_base",
      "notes": "Erekir HeatCrafter (HeatCrafter.java:88-91, Blocks.java maxEfficiency=1f, v160.8). Speed and liquid consumption scale with heat_eff; heat input is steady-state supplied_heat (not scaled by overdrive); power draw does not scale with heat_eff.",
      "params": [
        "heat_pct"
      ],
      "let": {
        "heat_eff": "min(param.heat_pct / 100, machine.max_heat_eff)",
        "supplied_heat": "machine.heat_req * heat_eff"
      },
      "craft_time": "recipe.time / (machine.speed * od * heat_eff)",
      "extra_ports": [
        {
          "id": "heat",
          "dir": "in",
          "resource": "heat",
          "amount": "supplied_heat * craft_time"
        }
      ]
    },
    "mindustry_flux_reactor": {
      "extends": "mindustry_heat_crafter",
      "notes": "Erekir VariableReactor / Flux Reactor (VariableReactor.java:82,131-143, v160.8). Both cyanogen consumption and power generation scale linearly with clamp(heat / maxHeat, 0, 1).",
      "let": {
        "net_power": "machine.power * heat_eff * od"
      }
    },
    "mindustry_drill": {
      "extends": "mindustry_base",
      "notes": "Shared ore-mining profile for Drill, BurstDrill, and BeamDrill (Drill.java:170-188,301-305; BurstDrill.java:53-55,94-99; BeamDrill.java:216-254, v160.8). Computes exact per-machine drill time from machine.drill_time, machine.hardness_mult, recipe.hardness, and beryllium_mult; machine-specific mandatory liquid (xin:liquid) and optional booster (xin:booster) consume at fixed /s * od.",
      "params": [
        "ore_tiles_2",
        "ore_tiles_3",
        "ore_tiles_4",
        "ore_tiles_9",
        "ore_tiles_16",
        "ore_tiles_25",
        "boosted"
      ],
      "let": {
        "tiles": "if(machine.max_tiles == 25, param.ore_tiles_25, if(machine.max_tiles == 16, param.ore_tiles_16, if(machine.max_tiles == 9, param.ore_tiles_9, if(machine.max_tiles == 4, param.ore_tiles_4, if(machine.max_tiles == 3, param.ore_tiles_3, if(machine.max_tiles == 2, param.ore_tiles_2, 1))))))",
        "boost": "if(param.boosted && machine.boost_rate > 0, machine.boost_mult, 1)",
        "dmult": "if(recipe.is_beryllium, machine.beryllium_mult, 1)",
        "base_time_s": "((machine.drill_time + machine.hardness_mult * recipe.hardness) / dmult) / game.ticks_per_second"
      },
      "craft_time": "base_time_s / (machine.speed * od * tiles * boost)",
      "extra_ports": [
        {
          "id": "liquid",
          "dir": "in",
          "resource_expr": "machine.req_res",
          "amount": "machine.req_rate * od * craft_time",
          "enabled": "machine.req_rate > 0"
        },
        {
          "id": "booster",
          "dir": "in",
          "resource_expr": "machine.boost_res",
          "amount": "machine.boost_rate * od * craft_time",
          "enabled": "param.boosted && machine.boost_rate > 0"
        }
      ]
    },
    "mindustry_wall_crafter": {
      "extends": "mindustry_base",
      "notes": "Shared wall-crushing profile for WallCrafter (cliff-crusher, large-cliff-crusher; WallCrafter.java:141-215, v160.8). Base time per sand = (drill_time / size) ticks; speed scales with wall tile_eff * boost * od; mandatory hydrogen (xin:liquid) and optional graphite booster (xin:booster) consume at fixed /s * od.",
      "params": [
        "tile_preset",
        "tile_efficiency",
        "boosted"
      ],
      "let": {
        "tile_eff": "if(param.tile_preset == 'custom', param.tile_efficiency, param.tile_preset.eff) / 100",
        "boost": "if(param.boosted && machine.boost_rate > 0, machine.boost_mult, 1)",
        "base_time_s": "(machine.drill_time / machine.size) / game.ticks_per_second"
      },
      "craft_time": "base_time_s / (machine.speed * od * tile_eff * boost)",
      "extra_ports": [
        {
          "id": "liquid",
          "dir": "in",
          "resource_expr": "machine.req_res",
          "amount": "machine.req_rate * od * craft_time",
          "enabled": "machine.req_rate > 0"
        },
        {
          "id": "booster",
          "dir": "in",
          "resource_expr": "machine.boost_res",
          "amount": "machine.boost_rate * od * craft_time",
          "enabled": "param.boosted && machine.boost_rate > 0"
        }
      ]
    },
    "mindustry_pump": {
      "extends": "mindustry_base",
      "notes": "Shared pumping profile for Pump (mechanical-pump, rotary-pump, impulse-pump, reinforced-pump; Pump.java:149,162, v160.8). Output scales with machine.pump_rate * tiles * floor_mult * od; reinforced-pump hydrogen input (xin:liquid) stays fixed at 1.5 * od / s.",
      "params": [
        "pump_tiles_4",
        "pump_tiles_9",
        "pump_floor"
      ],
      "let": {
        "tiles": "if(machine.max_tiles == 9, param.pump_tiles_9, if(machine.max_tiles == 4, param.pump_tiles_4, 1))",
        "floor_mult": "param.pump_floor.mult"
      },
      "output_amount": "port.amount * port.chance * machine.pump_rate * tiles * floor_mult",
      "extra_ports": [
        {
          "id": "liquid",
          "dir": "in",
          "resource_expr": "machine.req_res",
          "amount": "machine.req_rate * od * craft_time",
          "enabled": "machine.req_rate > 0"
        }
      ]
    },
    "mindustry_solid_pump": {
      "extends": "mindustry_base",
      "notes": "SolidPump and Fracker (water-extractor, oil-extractor; SolidPump.java:124-127, Fracker.java:32-38, v160.8). Output scales with tile_eff * od; oil-extractor sand and water inputs stay fixed at base rate * od.",
      "params": [
        "tile_preset",
        "tile_efficiency"
      ],
      "let": {
        "tile_eff": "if(param.tile_preset == 'custom', param.tile_efficiency, param.tile_preset.eff) / 100"
      },
      "output_amount": "port.amount * port.chance * tile_eff"
    },
    "mindustry_solar": {
      "extends": "mindustry_base",
      "notes": "Shared SolarGenerator profile (solar-panel, solar-panel-large; SolarGenerator.java:28-33, PowerGraph.java:100, v160.8). Outputs exact generated power (u/s when project rate is /s) on out:0; native_power_out=true prevents duplicating xout:power_out.",
      "let": {
        "net_power": "machine.power * global.solar_mult * od",
        "native_power_out": "true"
      },
      "output_amount": "abs(machine.power) * global.solar_mult"
    },
    "mindustry_thermal": {
      "extends": "mindustry_base",
      "notes": "ThermalGenerator (thermal-generator; ThermalGenerator.java:88, PowerGraph.java:100, v160.8). Power and power output port scale with sumAttribute(heat) * od = tile_eff * od (100% = 108 u/s); native_power_out=true prevents duplicating xout:power_out.",
      "params": [
        "tile_preset",
        "tile_efficiency"
      ],
      "let": {
        "tile_eff": "if(param.tile_preset == 'custom', param.tile_efficiency, param.tile_preset.eff) / 100",
        "net_power": "machine.power * tile_eff * od",
        "native_power_out": "true"
      },
      "output_amount": "abs(machine.power) * tile_eff"
    },
    "mindustry_unit": {
      "extends": "mindustry_base",
      "notes": "UnitFactory, Reconstructor, and UnitAssembler (UnitFactory.java:109,411; Reconstructor.java:155,339; UnitAssembler.java:179,531; UnitAssemblerModule.java, v160.8). Speed scales with od * global.unit_build_speed; resource inputs scale with global.unit_cost_mult (excluding upgraded input unit on Reconstructor via no_cost_scale=true). Tier 1 assembler recipes add +210 u/s basic-assembler-module power via recipe.extra_power.",
      "let": {
        "net_power": "(machine.power + recipe.extra_power) * od"
      },
      "craft_time": "recipe.time / (machine.speed * od * global.unit_build_speed)",
      "input_amount": "if(port.no_cost_scale, port.amount * port.chance, if(port.fixed_rate, port.amount * od * craft_time * global.unit_cost_mult, port.amount * port.chance * global.unit_cost_mult))"
    }
  }
}
