      "option_set": "tile_presets",
      "allowed_if": "option.tile_attr == machine.tile_attr || option.tile_attr == 'any'",
      "ui": {
        "widget": "combo",
        "placement": "panel",
        "group": "Tile placement"
      }
    },
    "tile_efficiency": {
      "label": "Custom tile efficiency",
      "tooltip": "In-game placement efficiency percentage for mixed floor or wall tiles.",
