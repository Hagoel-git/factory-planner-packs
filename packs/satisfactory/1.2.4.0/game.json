  "profiles": {
    "sf_production": {
      "notes": "Standard manufacturer profile: speed linear with clock (c = clock/100); Somersloop amp = 1 + sloops/slots multiplies outputs only; average power = machine.power * amp^2 * c^machine.power_exp * global.power_consumption_mult.mult; peak_power uses ceil(node.machines); Recipe Parts Cost Multiplier rounds integer items (>=1) or mL fluids (>=0.001 m3). Sources: raw/satisfactory/en-US.json (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Clock_speed, /wiki/Production_amplifier.",
      "params": [
        "clock",
        "somersloops"
      ],
      "let": {
        "c": "param.clock / 100",
        "amp": "if(machine.somersloop_slots > 0, 1 + param.somersloops / machine.somersloop_slots, 1)",
        "shards_per_machine": "clamp(ceil((param.clock - 100) / 50), 0, 3)",
        "pwr": "machine.power * amp ^ 2 * c ^ machine.power_exp * global.power_consumption_mult.mult"
      },
      "craft_time": "recipe.time / (machine.speed * c)",
      "input_amount": "if(port.resource.is_fluid, max(0.001, round(port.amount * 1000 * global.recipe_cost_mult.mult) / 1000), max(1, round(port.amount * global.recipe_cost_mult.mult))) * port.chance",
      "output_amount": "port.amount * port.chance * amp",
      "metrics": {
        "power": {
          "per_machine": "pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * pwr"
        },
        "shards": {
          "value": "ceil(max(0, node.machines - 1e-6)) * shards_per_machine"
        },
        "sloops": {
          "value": "ceil(max(0, node.machines - 1e-6)) * param.somersloops"
        }
      }
    },
    "sf_packager": {
      "notes": "Packager profile: inherits sf_production, but exempt from global.recipe_cost_mult.mult (verified in-game Satisfactory v1.2.4.0 so packaging/unpackaging cannot duplicate fluids or canisters).",
      "extends": "sf_production",
      "input_amount": "port.amount * port.chance"
    },
    "sf_variable_power": {
      "notes": "Variable-power manufacturers (Particle Accelerator, Converter, Quantum Encoder): avg_power = min_power + power_span/2, peak_power = ceil(max(0, node.machines - 1e-6)) * (min_power + power_span), scaled by amp^2 * c^power_exp * global.power_consumption_mult.mult. Sources: raw/satisfactory/en-US.json mVariablePowerConsumptionConstant/Factor (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Particle_Accelerator, /wiki/Converter, /wiki/Quantum_Encoder.",
      "extends": "sf_production",
      "let": {
        "scale": "amp ^ 2 * c ^ machine.power_exp * global.power_consumption_mult.mult",
        "pwr": "(recipe.min_power + recipe.power_span / 2) * scale",
        "peak_pwr": "(recipe.min_power + recipe.power_span) * scale"
      },
      "metrics": {
        "power": {
          "per_machine": "pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * peak_pwr"
        }
      }
    },
    "sf_extractor": {
      "notes": "Miners Mk.1-3 and Oil Extractor: extraction scales linearly with purity multiplier (0.5/1/2) and clock; power scales by c^machine.power_exp * global.power_consumption_mult.mult; peak_power uses ceil(max(0, node.machines - 1e-6)). Sources: raw/satisfactory/en-US.json (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Miner, /wiki/Oil_Extractor.",
      "params": [
        "purity",
        "clock"
      ],
      "let": {
        "c": "param.clock / 100",
        "shards_per_machine": "clamp(ceil((param.clock - 100) / 50), 0, 3)",
        "pwr": "machine.power * c ^ machine.power_exp * global.power_consumption_mult.mult"
      },
      "craft_time": "recipe.time / (machine.speed * param.purity.mult * c)",
      "metrics": {
        "power": {
          "per_machine": "pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * pwr"
        },
        "shards": {
          "value": "ceil(max(0, node.machines - 1e-6)) * shards_per_machine"
        }
      }
    },
    "sf_water_extractor": {
      "notes": "Water Extractor: no node purity (fixed 120 m3/min at 100% clock); power scales by c^machine.power_exp * global.power_consumption_mult.mult; peak_power uses ceil(max(0, node.machines - 1e-6)). Sources: raw/satisfactory/en-US.json Build_WaterPump_C (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Water_Extractor.",
      "params": [
        "clock"
      ],
      "let": {
        "c": "param.clock / 100",
        "shards_per_machine": "clamp(ceil((param.clock - 100) / 50), 0, 3)",
        "pwr": "machine.power * c ^ machine.power_exp * global.power_consumption_mult.mult"
      },
      "craft_time": "recipe.time / (machine.speed * c)",
      "metrics": {
        "power": {
          "per_machine": "pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * pwr"
        },
        "shards": {
          "value": "ceil(max(0, node.machines - 1e-6)) * shards_per_machine"
        }
      }
    },
    "sf_resource_well": {
      "notes": "Resource Well Extractor + Pressurizer: extraction scales with satellite node purity (30/60/120 m3/min at 100%) and Pressurizer clock; Pressurizer 150 MW * c^exp * power_consumption_mult is split evenly across well_nodes satellite extractors for avg power and ceil-rounded per Pressurizer for peak_power and shards. Sources: raw/satisfactory/en-US.json Build_FrackingSmasher_C & Build_FrackingExtractor_C (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Resource_Well_Pressurizer.",
      "params": [
        "purity",
        "clock",
        "well_nodes"
      ],
      "let": {
        "c": "param.clock / 100",
        "shards_per_pressurizer": "clamp(ceil((param.clock - 100) / 50), 0, 3)",
        "pwr_pressurizer": "machine.power * c ^ machine.power_exp * global.power_consumption_mult.mult",
        "pwr": "pwr_pressurizer / param.well_nodes"
      },
      "craft_time": "recipe.time / (machine.speed * param.purity.mult * c)",
      "metrics": {
        "power": {
          "per_machine": "pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines / param.well_nodes - 1e-6)) * pwr_pressurizer"
        },
        "shards": {
          "value": "ceil(max(0, node.machines / param.well_nodes - 1e-6)) * shards_per_pressurizer"
        }
      }
    },
    "sf_generator": {
      "notes": "Fuel-consuming power generators (Biomass Burner, Coal, Fuel, Nuclear): linear clock scaling for both power output (-machine.power * c) and fuel/water/waste rates (Satisfactory 1.0+ linear Nuclear scaling). Sources: raw/satisfactory/en-US.json (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Clock_speed, /wiki/Nuclear_Power_Plant.",
      "params": [
        "clock"
      ],
      "let": {
        "c": "param.clock / 100",
        "shards_per_machine": "clamp(ceil((param.clock - 100) / 50), 0, 3)"
      },
      "craft_time": "recipe.time / (machine.speed * c)",
      "metrics": {
        "power": {
          "per_machine": "-machine.power * c"
        },
        "shards": {
          "value": "ceil(max(0, node.machines - 1e-6)) * shards_per_machine"
        }
      }
    },
    "sf_geothermal": {
      "notes": "Geothermal Generator: average power output by geyser purity (100/200/400 MW avg = -200 * purity.mult), no overclocking, uses synthetic geothermal-geyser source item (V-NUM-4 requires >= 1 port). Sources: raw/satisfactory/en-US.json Build_GeneratorGeoThermal_C (v1.2.4.0), https://satisfactory.wiki.gg/wiki/Geothermal_Generator.",
      "params": [
        "purity"
      ],
      "craft_time": "recipe.time",
      "metrics": {
        "power": {
          "per_machine": "-machine.power * param.purity.mult"
        }
      }
    },
    "sf_sink": {
      "notes": "AWESOME Sink: consumes solid items with mResourceSinkPoints > 0 at selected belt throughput (60 / rate_per_min s per item). An active Sink draws a full 30 MW * global.power_consumption_mult.mult per physical machine (ceil(max(0, node.machines - 1e-6))) regardless of belt utilization, and generates recipe.sink_points per item sunk. Sources: raw/satisfactory/en-US.json Build_ResourceSink_C (v1.2.4.0), https://satisfactory.wiki.gg/wiki/AWESOME_Sink.",
      "params": [
        "belt_tier"
      ],
      "let": {
        "pwr": "machine.power * global.power_consumption_mult.mult"
      },
      "craft_time": "60 / param.belt_tier.rate_per_min",
      "metrics": {
        "power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * pwr"
        },
        "peak_power": {
          "value": "ceil(max(0, node.machines - 1e-6)) * pwr"
        },
        "sink_points": {
          "per_craft": "recipe.sink_points"
        }
      }
    },
    "sf_space_elevator": {
      "notes": "Space Elevator Phase 1-5 deliverable sinks: input quantities scale by global.space_elevator_cost_mult.mult (rounded to >= 1 item); post-solve completion_time_min = 1 / (node.crafts * 60) and completion_time_h = 1 / (node.crafts * 3600) report phase completion time at solved input flow. Sources: https://satisfactory.wiki.gg/wiki/Space_Elevator (Satisfactory v1.2.4.0).",
      "params": [],
      "craft_time": "recipe.time",
      "input_amount": "max(1, round(port.amount * global.space_elevator_cost_mult.mult))",
      "metrics": {
        "completion_time_min": {
          "value": "if(node.crafts > 0, 1 / (node.crafts * 60), 0)"
        },
        "completion_time_h": {
          "value": "if(node.crafts > 0, 1 / (node.crafts * 3600), 0)"
        }
      }
    }
  },
  "include": [
    "resources.json",
    "machines.json",
    "recipes",
    "waivers.json"
  ]
}
